@model library.Models.Note

@{
    ViewData["Title"] = "Delete a Note";
}

<h1 class="mb-3">Delete a Note</h1>

<div class="card card-body" style="max-width:36rem">

    <p>Are you sure you want to delete this note?</p>

    <dl class="row mb-2">
        <dt class="col-4">Note ID</dt>
        <dd class="col-8">@Model.NoteId</dd>

        <dt class="col-4">Title</dt>
        <dd class="col-8">@Model.Title</dd>

        <dt class="col-4">Body</dt>
        <dd class="col-8">@(Model.Body ?? "—")</dd>

        <dt class="col-4">Created On</dt>
        <dd class="col-8">@Model.CreatedOn</dd>
    </dl>

    <p class="text-muted small">
        Deleting this note cannot be undone.
    </p>

    <form asp-action="Delete"
          asp-route-id="@Model.NoteId"
          method="post">

        <button type="submit" class="btn btn-danger">
            Delete
        </button>

        <a asp-action="Index" class="btn btn-link">
            Cancel
        </a>
    </form>
</div>
