@model library.Models.Note

@{
    ViewData["Title"] = "Add a Note";
}

<h1>Add a Note</h1>

<form asp-action="Create" method="post"
      class="card card-body" style="max-width: 36rem">

    <div class="mb-3">
        <label asp-for="Title" class="form-label">
            Title
        </label>
        <input asp-for="Title" class="form-control" required />
        <span asp-validation-for="Title"
              class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Body" class="form-label">
            Body (optional)
        </label>
        <textarea asp-for="Body" class="form-control"
                  rows="5"></textarea>
        <span asp-validation-for="Body"
              class="text-danger"></span>
    </div>

    <div>
        <button type="submit" class="btn btn-primary">
            Save Note
        </button>

        <a asp-action="Index" class="btn btn-secondary">
            Cancel
        </a>
    </div>
</form>
