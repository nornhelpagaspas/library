@model library.Models.Note

@{
    ViewData["Title"] = "Edit a Note";
}

<h1 class="mb-3">Edit a Note</h1>

<form asp-action="Edit" method="post"
      class="card card-body" style="max-width:36rem">

    <input type="hidden" asp-for="NoteId" />

    <div class="mb-3">
        <label asp-for="Title" class="form-label">Title</label>
        <input asp-for="Title" class="form-control" required />
        <span asp-validation-for="Title"
              class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Body" class="form-label">Body</label>
        <textarea asp-for="Body" class="form-control"
                  rows="5"></textarea>
        <span asp-validation-for="Body"
              class="text-danger"></span>
    </div>

    <div>
        <button type="submit" class="btn btn-primary">
            Save Changes
        </button>

        <a asp-action="Index" class="btn btn-link">
            Cancel
        </a>
    </div>
</form>
