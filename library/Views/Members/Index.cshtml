@model List<library.Models.Member>

@{
    ViewData["Title"] = "Members";
}

<h1>Library Members</h1>

<p>@Model.Count members registered</p>

<p>
    <a asp-action="Create" class="btn btn-primary">
        Add a member
    </a>
</p>

<table class="table table-striped table-hover">
    <thead class="table-dark">
        <tr>
            <th>ID</th>
            <th>Full Name</th>
            <th>Email</th>
            <th>Member Type</th>
            <th>Actions</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var member in Model)
        {
            <tr>
                <td>@member.MemberId</td>
                <td>@member.FullName</td>
                <td>@(member.Email ?? "—")</td>
                <td>@member.MemberType</td>
                <td>
                    @* Task 15 adds the Edit button here *@
                    @* Task 16 adds the Delete button here *@
                </td>
            </tr>
        }
    </tbody>
</table>