@model library.Models.Member

@{
    ViewData["Title"] = "Add a Member";
}

<h1>Add a Member</h1>

<form asp-action="Create" method="post"
      class="card card-body" style="max-width: 36rem">

    <div class="mb-3">
        <label asp-for="FullName" class="form-label">
            Full Name
        </label>
        <input asp-for="FullName" class="form-control" required />
        <span asp-validation-for="FullName"
              class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Email" class="form-label">
            Email (optional)
        </label>
        <input asp-for="Email" type="email"
               class="form-control" />
        <span asp-validation-for="Email"
              class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="MemberType" class="form-label">
            Member Type
        </label>

        <select asp-for="MemberType" class="form-select" required>
            <option value="Regular">Regular</option>
            <option value="Student">Student</option>
            <option value="Faculty">Faculty</option>
        </select>
    </div>

    <div>
        <button type="submit" class="btn btn-primary">
            Save Member
        </button>

        <a asp-action="Index" class="btn btn-secondary">
            Cancel
        </a>
    </div>
</form>